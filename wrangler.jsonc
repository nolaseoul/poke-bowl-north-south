{
  "name": "poke-bowl-north-south",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "LEAGUE",
      "database_name": "poke-bowl-league",
      "database_id": "9ddd893d-f62a-40b3-a13e-b8a9735607b9"
    }
  ],
  "main": "worker/index.mjs"
}
