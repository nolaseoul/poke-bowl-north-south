{
  "name": "poke-bowl-north-south",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "LEAGUE",
      "database_name": "poke-bowl-league",
      "database_id": "9ddd893d-f62a-40b3-a13e-b8a9735607b9"
    }
  ],
  "main": "worker/index.mjs",
  "durable_objects": {
    "bindings": [
      {
        "name": "PVP",
        "class_name": "PvPRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "pvp-v1",
      "new_sqlite_classes": [
        "PvPRoom"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "pokeball.gg",
      "custom_domain": true
    },
    {
      "pattern": "www.pokeball.gg",
      "custom_domain": true
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://urkxyzvczwsmznudrqjz.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_QyQlOdWJs3CeQJB1pakxhA_X0M4B3bp",
    "GOOGLE_ENABLED": "false"
  }
}
